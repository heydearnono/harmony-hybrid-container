{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // ⚠️ 下面这段由 harmony/switch-runtime.sh 整体重写，请不要手改。
        //    切平台：bash harmony/switch-runtime.sh hos | ohos
        //
        //    仓库默认值是 HarmonyOS（= devecocli create 的原值），
        //    这样别人用 DevEco Studio 下载后能直接打开；本机免登录编译前先切到 ohos。
        //    两侧差异与依据见 harmony/README.md 的「另一条路」。
        // >>> PLATFORM BLOCK >>>
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        // <<< PLATFORM BLOCK <<<
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}